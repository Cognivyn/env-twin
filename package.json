{
  "name": "env-twin",
  "version": "1.1.1",
  "description": "Synchronize your .env.example and .env files effortlessly. env-twin ensures your environment variable templates and actual configurations stay in sync by copying missing keys, highlighting differences, and keeping your project's environment setup consistent and up to date.",
  "keywords": [
    "configuration",
    "dotenv",
    "env",
    "environment",
    "example",
    "sync",
    "template"
  ],
  "homepage": "https://github.com/Cognivyn/env-twin#readme",
  "bugs": {
    "url": "https://github.com/Cognivyn/env-twin/issues"
  },
  "license": "MIT",
  "author": "S Saha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cognivyn/env-twin.git"
  },
  "bin": {
    "env-twin": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "bun test",
    "coverage": "bun run scripts/check-coverage.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run build && bun run coverage && npm pack --dry-run",
    "start": "bun dist/index.js",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@types/bun": "^1.3.3",
    "@types/node": "^20.11.19",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
