{
    "name": "env-twin",
    "version": "1.1.1",
    "author": "S Saha",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cognivyn/env-twin.git"
    },
    "main": "dist/index.js",
    "module": "dist/index.js",
    "devDependencies": {
        "@changesets/cli": "^2.29.4",
        "@types/bun": "^1.3.3",
        "@types/node": "^20.11.19",
        "oxfmt": "^0.59.0",
        "oxlint": "^1.74.0",
        "prettier": "^3.5.3",
        "typescript": "^5.8.3"
    },
    "bin": {
        "env-twin": "./dist/index.js"
    },
    "bugs": {
        "url": "https://github.com/Cognivyn/env-twin.issues"
    },
    "description": "Synchronize your .env.example and .env files effortlessly. env-twin ensures your environment variable templates and actual configurations stay in sync by copying missing keys, highlighting differences, and keeping your project's environment setup consistent and up to date.",
    "engines": {
        "node": ">=16.0.0"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "homepage": "https://github.com/Cognivyn/env-twin#readme",
    "keywords": [
        "env",
        "dotenv",
        "environment",
        "sync",
        "example",
        "template",
        "configuration"
    ],
    "license": "MIT",
    "scripts": {
        "test": "bun test",
        "build": "tsc",
        "start": "bun dist/index.js",
        "format": "oxfmt .",
        "lint": "oxlint .",
        "lint:format": "prettier --write .",
        "changeset": "changeset",
        "changeset:version": "changeset version",
        "changeset:publish": "changeset publish"
    },
    "type": "module",
    "types": "dist/index.d.ts"
}
