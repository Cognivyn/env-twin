{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "off",
    "no-useless-catch": "off",
    "no-control-regex": "off"
  },
  "env": {
    "builtin": true
  }
}
